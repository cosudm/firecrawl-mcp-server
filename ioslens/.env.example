# =============================================================================
# iOSLENS control plane — environment template.
# Copy to .env (auto-loaded by bin/ioslens.mjs on Node 20.12+) and fill in.
# Every value has a safe offline default; nothing here is required to run the
# in-memory pilot. Set DATABASE_URL + ENTRA_* to go production.
# =============================================================================

# --- Transport -------------------------------------------------------------
MCP_TRANSPORT=stdio            # stdio | http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# --- Matrix + audit persistence (§02, §04) ---------------------------------
# When set, the app uses PostgreSQL 15+ / pgvector for both the Matrix and the
# append-only audit store. Requires `npm install pg` and `node bin/migrate.mjs`.
# DATABASE_URL=postgres://ioslens:ioslens@localhost:5432/ioslens

# --- Pilot regime scope (§04, §06.6) ---------------------------------------
ACTIVE_ONLY=false              # true = restrict decisions to FERPA/THECB/SACSCOC
EMBEDDING_MODEL=ioslens-hash-v1
EMBEDDING_DIM=1536

# --- Layer 1 authorization: Entra (§05) ------------------------------------
# MCP_AUTH defaults to "entra" when ENTRA_TENANT_ID + ENTRA_AUDIENCE are set,
# otherwise "dev" (insecure — local only).
MCP_AUTH=dev                   # entra | dev
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AUDIENCE=api://ioslens-mcp
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0     # optional override
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys  # optional override

# --- stdio Layer 1 ---------------------------------------------------------
# In dev auth, the stdio session is granted these roles. In entra auth, the
# launcher must supply a validated bearer token via MCP_STDIO_TOKEN instead.
MCP_DEV_ROLES=Compliance.Read,Compliance.Decide,Audit.Read
MCP_DEV_PRINCIPAL=dev-local
# MCP_STDIO_TOKEN=eyJ...
